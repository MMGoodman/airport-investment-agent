# ==========================================================================
# Server
# ==========================================================================

# API port. The Vite dev server proxies /api and /health here.
PORT=
# Language the UI opens on: he | en. The EN/HE control still switches per session.
DEFAULT_LANG=

# ==========================================================================
# Google Gemini
# Answers the text path, and is the brain inside both cascades.
# ==========================================================================

# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model with tool calling.
GEMINI_MODEL=

# ==========================================================================
# OpenAI
# Two roles: the native speech-to-speech path, and the assembled cascade's voice.
# ==========================================================================

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
# alloy ash ballad coral echo sage shimmer verse marin cedar
OPENAI_REALTIME_VOICE=
# A voice carries an accent; the best English reader is not always the best Hebrew one.
OPENAI_REALTIME_VOICE_HE=
# gpt-4o-transcribe | gpt-4o-mini-transcribe | whisper-1.
# whisper-1 mangles spelled-out airport codes.
OPENAI_TRANSCRIBE_MODEL=
# When a turn ends, and what counts as an interruption.
#   semantic - judges whether the THOUGHT is finished. Rides through a breath
#              mid-sentence, but has no volume threshold, so room noise can truncate
#              an answer.
#   server   - a silence timer with a loudness threshold. Crude about meaning, but
#              the only way to say "ignore anything quieter than this".
OPENAI_VAD_TYPE=
# semantic only: low | medium | high
OPENAI_VAD_EAGERNESS=
# server only: 0..1, higher ignores quieter sound
OPENAI_VAD_THRESHOLD=
# server only: pause before the turn ends. OpenAI's own default of 200 split
# one question into four fragments.
OPENAI_VAD_SILENCE_MS=
# server only: audio kept from before speech was detected
OPENAI_VAD_PREFIX_MS=

# ==========================================================================
# ElevenLabs
# A managed cascade: their transcriber, their LLM, their voice.
# The agent itself is defined in this repo and pushed with `npm run sync:agent`,
# so it cannot drift from the text agent.
# ==========================================================================

# elevenlabs.io -> Settings -> API Keys
ELEVENLABS_API_KEY=
# Printed by `npm run sync:agent`
# Voice. Their verified-languages metadata lists no Hebrew for any of these, and the
# library returns nothing for a Hebrew search - but they read Hebrew well in practice, so
# the metadata marks what has been tested rather than what works.
#   pqHfZKP75CvOlQylNhV4  Bill    - wise, mature, balanced   (default)
#   nPczCjzI2devNBz1zQrb  Brian   - deep, resonant, comforting
#   cgSgspJ2msm6clMCkdW9  Jessica - playful, bright, warm
#   FGY2WhTYpPnrIDTdsKH5  Laura   - enthusiast, quirky
#   Xb7hH8MSUJpSbSDYk0k2  Alice   - clear, engaging, british
#   cjVigY5qzO86Huf0OWal  Eric    - smooth, trustworthy
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
# Roughly 90 accepted, across gpt-5.x, gemini-3.x, claude, qwen, grok.
# Kept at the text path's tier so an A/B compares transports, not models.
ELEVENLABS_LLM=
# scribe_realtime | scribe_v2_turbo | scribe_v2 | elevenlabs.
# On a cascade the transcript is what the LLM sees, so this is a correctness setting.
ELEVENLABS_ASR_PROVIDER=
# Of their nine voice models, only eleven_v3_conversational carries Hebrew, and
# preset languages validate against this one - so Hebrew forces it here.
ELEVENLABS_TTS_MODEL=
# English sessions override the above at connect time with the low-latency model.
# Blank it if a call fails to start.
ELEVENLABS_FAST_TTS=
# eleven_realtime_v1_mini | _max collapse the cascade into one native model.
# Gated: returns 403 on a workspace whose plan does not include them.
ELEVENLABS_REALTIME_MODEL=

# ==========================================================================
# Soniox
# Recogniser for the assembled cascade. Switches language mid-sentence without
# being told which to expect, which is the pattern a bilingual caller produces.
# ==========================================================================

# console.soniox.com -> project -> API keys. One key covers every Soniox API.
SONIOX_API_KEY=
# stt-rt-v5 is current. Sixty languages, Hebrew among them.
SONIOX_STT_MODEL=
# Soniox does have TTS, on tts-rt.soniox.com rather than the api. subdomain.
SONIOX_TTS_MODEL=
# Daniel Nina Bryce Kayla Nora Emerson
SONIOX_TTS_VOICE=
# Streaming bills per hour. An unfunded account mints keys fine and then 402s on
# the first real audio, so the switcher gates on this rather than on the key.
SONIOX_FUNDED=

# ==========================================================================
# The assembled cascade
# Stages, not vendors. Soniox recognises, our agent thinks, and whoever is named
# here speaks - swapping one stage changes nothing else, which is the whole reason
# to assemble a pipeline instead of buying one.
# ==========================================================================

# openai | soniox
CASCADE_TTS_PROVIDER=
# openai only: gpt-4o-mini-tts | tts-1
CASCADE_TTS_MODEL=
