        <mxCell id="h27" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;14 · placement = anywhere&lt;/b&gt; → runTool · callId + חתימה&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="841" width="420" height="36" as="geometry"/></mxCell>
