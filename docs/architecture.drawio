        <mxCell id="n7" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b style=&quot;font-size:16px&quot;&gt;gpt-realtime מדבר&lt;/b&gt;&lt;br&gt;אותו מודל &amp;#183; מתחיל לדבר לפני שסיים לחשוב&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="570" width="600" height="84" as="geometry"/></mxCell>
