        <mxCell id="n2" value="One model listens, thinks and speaks. Your server is touched once per turn, for the tool." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#6b6b6b;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="1480" height="24" as="geometry"/></mxCell>
