        <mxCell id="n19" value="&lt;div dir=&#39;rtl&#39; style=&#39;text-align:right&#39;&gt;OpenAI &amp;#183; Google&lt;br&gt;שני חשבונות. והתמלול חוזר לשליטתך: gpt-4o-transcribe + אוצר המילים שלך&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="n14">
