        <mxCell id="n8" value="&lt;div dir='rtl' style='text-align:right'&gt;&amp;#10007;&amp;nbsp; gemini &amp;#8594; eleven_v3 &amp;#183; קול &amp;#8212; &lt;b&gt;8,569 ms&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#8a1f1a;" vertex="1" parent="n3"><mxGeometry x="20" y="172" width="660" height="28" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;ספקים חיצוניים &amp;#8212; ארבעה&lt;/b&gt;&lt;/div&gt;" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="n3"><mxGeometry x="20" y="212" width="660" height="18" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;div dir='rtl' style='text-align:right'&gt;OpenAI &amp;#183; Google &amp;#183; &lt;b&gt;Soniox&lt;/b&gt; &amp;#183; &lt;b&gt;ElevenLabs&lt;/b&gt;&lt;br&gt;ארבעה חשבונות, ארבעה מפתחות, שני חיובים לפי דקות אודיו&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="n3"><mxGeometry x="20" y="234" width="660" height="54" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;קוד ייעודי שצריך תחזוקה&lt;/b&gt;&lt;/div&gt;" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="n3"><mxGeometry x="20" y="300" width="660" height="18" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;div dir='rtl' style='text-align:right'&gt;src/live/soniox.js &amp;#183; src/live/elevenlabs.js&lt;br&gt;scripts/sync-elevenlabs-agent.js &amp;#183; scripts/check-soniox.js&lt;br&gt;/api/voice/signed-url &amp;#183; /api/voice/soniox-key &amp;#183; /api/voice/speak&lt;br&gt;&lt;b&gt;ורשימת TOOL_NAMES כפולה שאף אחד לא אוכף&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="n3"><mxGeometry x="20" y="322" width="660" height="88" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;מה זה נותן&lt;/b&gt;&lt;br&gt;הוכחה שאתה יודע למדוד את ההבדל בין ספקים &amp;#8212; וזה הישג אמיתי.&lt;br&gt;&lt;b&gt;מה זה עולה&lt;/b&gt;&lt;br&gt;ארבעה משטחי כשל, שלושה מתמללים שונים, ובחירה שהמשתמש לא אמור לעשות.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="n3"><mxGeometry x="20" y="424" width="660" height="130" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;div dir='rtl' style='text-align:right'&gt;מומלץ &amp;#8212; &lt;b&gt;מוצר&lt;/b&gt;&lt;/div&gt;" style="swimlane;html=1;startSize=46;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;rounded=0;swimlaneFillColor=#f2f8f1;" vertex="1" parent="1"><mxGeometry x="840" y="116" width="700" height="600" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;נתיבים &amp;#8212; שניים&lt;/b&gt;&lt;/div&gt;" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="n14"><mxGeometry x="20" y="54" width="660" height="18" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;div dir='rtl' style='text-align:right'&gt;gemini-3.1-flash-lite &amp;#183; טקסט &amp;#8212; &lt;b&gt;ברירת מחדל&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n14"><mxGeometry x="20" y="76" width="660" height="28" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;div dir='rtl' style='text-align:right'&gt;gpt-realtime &amp;#183; קול &amp;#8212; &lt;b&gt;340 ms&lt;/b&gt; &amp;#183; מודל אחד, בלי מסירות&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n14"><mxGeometry x="20" y="108" width="660" height="28" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;ספקים חיצוניים &amp;#8212; שניים&lt;/b&gt;&lt;/div&gt;" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="n14"><mxGeometry x="20" y="148" width="660" height="18" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;div dir='rtl' style='text-align:right'&gt;OpenAI &amp;#183; Google&lt;br&gt;שני חשבונות. והתמלול חוזר לשליטתך: gpt-4o-transcribe + אוצר המילים שלך&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="n14"><mxGeometry x="20" y="170" width="660" height="54" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;מה למחוק&lt;/b&gt;&lt;/div&gt;" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="n14"><mxGeometry x="20" y="236" width="660" height="18" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;div dir='rtl' style='text-align:right'&gt;&amp;#10007; src/live/soniox.js &amp;#183; src/live/elevenlabs.js&lt;br&gt;&amp;#10007; scripts/sync-elevenlabs-agent.js &amp;#183; scripts/check-soniox.js&lt;br&gt;&amp;#10007; /api/voice/signed-url &amp;#183; /api/voice/soniox-key &amp;#183; /api/voice/speak&lt;br&gt;&amp;#10007; מפתחות SONIOX_* ו-ELEVENLABS_* מ-.env&lt;br&gt;&amp;#10007; בורר הספקים &amp;#8212; אלא אם ההשוואה עצמה היא המוצר&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="n14"><mxGeometry x="20" y="258" width="660" height="100" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;&amp;#9888; לאמת לפני שמתחייבים&lt;/b&gt;&lt;br&gt;איכות העברית ב-gpt-realtime. כל נתוני העברית שלך נמדדו על ElevenLabs.&lt;br&gt;3-4 שיחות אמיתיות בעברית, וקרא את התמלולים. אם העברית טובה &amp;#8212; סגרת.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="n14"><mxGeometry x="20" y="372" width="660" height="100" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;ההפרש&lt;/b&gt;&lt;br&gt;פי 25 בזמן תגובה &amp;#183; חצי מהספקים &amp;#183; שבעה קבצים ונקודות קצה פחות &amp;#8212; בלי לגעת בליבה.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="n14"><mxGeometry x="20" y="486" width="660" height="68" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b style=&quot;font-size:15px&quot;&gt;מה לא משתנה &amp;#8212; הליבה, וזה מה שכבר נכון אצלך&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. האודיו לא עובר דרך השרת שלך.&lt;/b&gt; דפדפן &amp;#8596; ספק, ישיר. באפליקציית ווב זה לא נתון לוויכוח &amp;#8212; רילוי מדיה עולה השהיה, פס רווח, ומאבד ביטול הד ו-jitter buffer ש-WebRTC נותן בחינם.&lt;br&gt;&lt;b&gt;2. סודות רק בשרת.&lt;/b&gt; הדפדפן מקבל כרטיס זמני שפג תוך דקות. אף פעם לא מפתח חשבון.&lt;br&gt;&lt;b&gt;3. הכלים רצים בשרת. תמיד.&lt;/b&gt; המודל אומר שם, אתה מריץ. הדפדפן צינור, לא מחשבון.&lt;br&gt;&lt;b&gt;4. הפרומפט והכלים חיים בגיט&lt;/b&gt; ונדחפים לספק &amp;#8212; לא נערכים בדשבורד שלו.&lt;br&gt;&lt;br&gt;&lt;b&gt;הקבצים שלא נגעת בהם בכל המעבר הזה:&lt;/b&gt; src/scoring/ &amp;#183; src/data/ &amp;#183; src/agent/ &amp;#183; server/index.js&lt;br&gt;&lt;b&gt;ולמה זה יחזיק גם אם תגדל:&lt;/b&gt; POST /api/tool + runTool לא יודעים מי קרא להם. אם מחר תצטרך טלפוניה &amp;#8212; שיחה שלא עוברת בדפדפן בכלל &amp;#8212; רק שכבת החיווט משתנה. המנוע, הכלים והפרומפט נשארים.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="756" width="1480" height="290" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
