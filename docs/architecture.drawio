        <mxCell id="x15" value="live/tools.js → POST /api/tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x3"><mxGeometry x="18" y="380" width="430" height="26" as="geometry"/></mxCell>
