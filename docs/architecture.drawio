        <mxCell id="n1" value="Today vs recommended" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1480" height="40" as="geometry"/></mxCell>
        <mxCell id="n2" value="Same core, fewer edges. The architecture is already right &amp;#8212; what is heavy is running four paths and four vendors at once." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#6b6b6b;" vertex="1" parent="1"><mxGeometry x="60" y="66" width="1480" height="24" as="geometry"/></mxCell>
