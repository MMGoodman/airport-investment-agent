        <mxCell id="n27" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;12 &amp;#183; כותב את כל התשובה, ורק אז מדבר&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1120" y="990" width="240" height="60" as="geometry"/></mxCell>
