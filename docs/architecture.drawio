        <mxCell id="n49" value="client tool handler (elevenlabs.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="418" width="440" height="42" as="geometry"/></mxCell>
        <mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#8a8a8a;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n47" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n51" value="&lt;b&gt;POST /api/tool &amp;#8594; runTool&lt;/b&gt; &amp;#8212; in memory, ~ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="476" width="440" height="42" as="geometry"/></mxCell>
        <mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#8a8a8a;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n49" target="n51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n53" value="eleven_v3_conversational &amp;#8212; TTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;arcSize=12;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1100" y="534" width="440" height="42" as="geometry"/></mxCell>
        <mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#8a8a8a;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n51" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n55" value="onModeChange speaking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="592" width="440" height="42" as="geometry"/></mxCell>
        <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#8a8a8a;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n53" target="n55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n57" value="&amp;#9201; &lt;b&gt;only one boundary is exposed&lt;/b&gt; &amp;#8212; when it started speaking.&lt;br&gt;Hebrew forces their slowest TTS model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="656" width="440" height="84" as="geometry"/></mxCell>
        <mxCell id="n58" value="&lt;b&gt;YOUR LEVERS, IN ORDER OF EFFECT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Payload size.&lt;/b&gt; One rank_airports call returned 13.5 KB (~3,400 tokens) the model had to read before opening its mouth. VOICE_ADDENDUM + topN 3 &amp;#8594; 4.3 KB, a 68% cut. Biggest lever there was, and 100% yours.&lt;br&gt;&lt;b&gt;2. Architecture.&lt;/b&gt; Native vs cascade is a ~4&amp;#215; gap. Choosable, not tunable.&lt;br&gt;&lt;b&gt;3. Turn detection.&lt;/b&gt; A wasted turn costs seconds; tuning costs milliseconds. A 200 ms VAD split one question into four fragments; turn_eagerness=eager lost 34 s in one session.&lt;br&gt;&lt;b&gt;4. TTS model choice.&lt;/b&gt; Hebrew locks ElevenLabs to its slowest model; English swaps at connect time.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOT YOURS:&lt;/b&gt; STT, LLM and TTS inference time. Note the engine is never the bottleneck &amp;#8212; runTool is a pure in-memory lookup over JSON loaded once." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="1480" height="210" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gptflow" name="3 - GPT: the simple path">
