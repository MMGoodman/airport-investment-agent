node_modules/
.env
# Copies of it are copies of the keys. `.env.example` is the tracked one.
.env.*
!.env.example
dist/
data/raw/

.ipynb_checkpoints/

notebooks/*.html
data/knowledge/

# Snapshots of remote agent config taken before a sync overwrites it.
.backups/

# Working files for probes and one-off checks.
.scratch/

# Stored conversations: transcripts, not recordings. Local to a deployment.
data/sessions/

# The previous contents of data/agents.json, kept before every write. Local history of one
# deployment's agents — useful on the machine that made them, meaningless in the repo.
data/.agents-backups/

# Agents created in this deployment. Runtime state, like the sessions and the backups
# beside it — the file is written by the server and restored from data/.agents-backups/,
# not from the repo.
data/agents.json
