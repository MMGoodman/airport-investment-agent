        <mxCell id="n6" value="&lt;div dir='rtl' style='text-align:right'&gt;gpt-realtime &amp;#183; קול &amp;#8212; &lt;b&gt;340 ms&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n3"><mxGeometry x="20" y="108" width="660" height="28" as="geometry"/></mxCell>
