# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Free-tier quota is per model and per day. If chat returns HTTP 429 while
# GET /api/rankings still works, the model is rate limited, not the app.
# GET http://localhost:3001/api/models lists what this key can reach; swap in
# another flash model here and restart.
GEMINI_MODEL=gemini-3.1-flash-lite

PORT=3001

# --- Live voice (optional) ---
# Without these the switcher still lists both providers, marked "no key".

# OpenAI Realtime — speech-to-speech over WebRTC. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar.
# marin and cedar are the current pair. A voice carries an accent, so the best English
# reader is not automatically the best Hebrew one — try cedar if marin's Hebrew grates.
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VOICE_HE=marin
# whisper-1 mangles spelled-out airport codes; gpt-4o-transcribe does not.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Semantic turn detection: how soon it decides you have finished a sentence.
# low waits for a finished thought, high cuts in sooner. The server-VAD default of a
# 200 ms silence timer split one question into four fragments.
OPENAI_VAD_EAGERNESS=low

# ElevenLabs Agents. Key: elevenlabs.io -> Settings -> API Keys.
# Agent id: run `npm run sync:agent` and paste what it prints — it creates the agent
# from this repo's SYSTEM_PROMPT and toolSchemas so the config stays in git.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM=gemini-3.1-flash-lite
# Their four transcribers, all in-house and all Hebrew-capable:
# scribe_realtime (default), scribe_v2_turbo, scribe_v2, elevenlabs.
# Worth an A/B — on a cascade the transcript is what the LLM sees, so this is a
# correctness setting, not a cosmetic one.
ELEVENLABS_ASR_PROVIDER=scribe_realtime
# eleven_v3_conversational is the only voice model of theirs whose language list includes
# Hebrew, and preset languages are validated against this one — so Hebrew forces it here.
ELEVENLABS_TTS_MODEL=eleven_v3_conversational
# English sessions override the above at connect time with the low-latency model.
# Blank it if a call fails to start.
ELEVENLABS_FAST_TTS=eleven_flash_v2_5
# Blank = cascade (ASR -> LLM -> TTS). eleven_realtime_v1_mini / _max collapse it into one
# native speech-to-speech model, but that is a gated feature and returns 403 on a workspace
# whose plan does not include it.
ELEVENLABS_REALTIME_MODEL=

# Soniox — the cascade this repo assembles itself: their STT, our agent, their TTS.
# The only path where each stage can be timed separately.
# Key: console.soniox.com
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v5
# Synthesis for the assembled cascade. Soniox has no TTS on this account and the
# ElevenLabs key is scoped to convai, so OpenAI takes this stage.
CASCADE_TTS_MODEL=gpt-4o-mini-tts
# Who speaks the assembled cascade's answer. Soniox has TTS (tts-rt-v2, Hebrew, voice
# "Daniel") but returns 402 until the organization has funds; OpenAI holds the stage
# meanwhile. Swapping is this one line.
CASCADE_TTS_PROVIDER=openai
SONIOX_TTS_MODEL=tts-rt-v2
SONIOX_TTS_VOICE=Daniel
# Streaming bills per hour. An unfunded account mints keys fine and then 402s on the first
# real audio, so the switcher gates on this rather than on the key existing.
SONIOX_FUNDED=false
