        <mxCell id="n12" value="&lt;div dir=&#39;rtl&#39; style=&#39;text-align:right&#39;&gt;src/live/soniox.js &amp;#183; src/live/elevenlabs.js&lt;br&gt;scripts/sync-elevenlabs-agent.js &amp;#183; scripts/check-soniox.js&lt;br&gt;/api/voice/signed-url &amp;#183; /api/voice/soniox-key &amp;#183; /api/voice/speak&lt;br&gt;&lt;b&gt;ורשימת TOOL_NAMES כפולה שאף אחד לא אוכף&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="n3">
