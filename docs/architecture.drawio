· gpt-4o-transcribe — parallel listener" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x30"><mxGeometry x="18" y="48" width="430" height="86" as="geometry"/></mxCell>
        <mxCell id="x32" value="Google Gemini — generateContent, the text path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x30"><mxGeometry x="18" y="146" width="430" height="24" as="geometry"/></mxCell>
        <mxCell id="x33" value="Soniox — wss stt-rt-v5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x30"><mxGeometry x="18" y="174" width="430" height="24" as="geometry"/></mxCell>
        <mxCell id="x34" value="ElevenLabs Agents — their LLM runs on their side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x30"><mxGeometry x="18" y="202" width="430" height="24" as="geometry"/></mxCell>
        <mxCell id="x35" value="Open-Meteo — no key, no account
reached ONLY from the server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x30"><mxGeometry x="18" y="238" width="430" height="38" as="geometry"/></mxCell>
        <mxCell id="x36" value="&lt;div dir=&quot;rtl&quot; style=&quot;text-align:right&quot;&gt;&lt;b&gt;מה מוגן ואיפה:&lt;/b&gt; מפתחות החשבון לעולם לא עוזבים את השרת. הדפדפן מקבל מפתח זמני שחי דקות.&lt;br&gt;כל קריאת כלי נרשמת עם callId וחתימת SHA-256, והפאנל מיישב מולה — כי בנתיבי הקול הדפדפן הוא שמוסר את התוצאה למודל.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=right;spacingRight=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="x30"><mxGeometry x="18" y="296" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="x37" value="audio + data channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="x11" target="x31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x38" value="PCM16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="x12" target="x21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x39" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="x21" target="x31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="x15" target="x24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#82b366;" edge="1" parent="1" source="x24" target="x23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x42" value="get_airport_weather only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="x23" target="x35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x43" value="session config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="x19" target="x31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x44" value="WHAT IS CHECKED" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1500" height="16" as="geometry"/></mxCell>
        <mxCell id="x45" value="npm test — 52 tests   ·   npm run verify — 44 engine checks   ·   npm run eval — 19 cases across two model paths, provenance 19/19
src/live/__tests__/browser-safe.test.js walks the real client module graph and fails on any node: import — the build cannot catch that, it compiles such code clean and blanks the page on load." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="822" width="1510" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hybrid-placement" name="10 - Where the hybrid sits">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="x1" value="Where the hybrid sits — three places a tool can run" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1600" height="40" as="geometry"/></mxCell>
        <mxCell id="x2" value="A Realtime session takes two connections: the browser holds the audio, and this server can hold a second one addressed by call id. Placement is not &quot;which transport&quot; — it is who answers the function call, on the same session." style="text;html=1;fontSize=13;align=left;verticalAlign=top;fontColor=#6b6b6b;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="22" as="geometry"/></mxCell>
        <mxCell id="x3" value="CORRECTING WHAT THIS TAB USED TO SAY" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1500" height="16" as="geometry"/></mxCell>
        <mxCell id="x4" value="It said a tool the browser must not invoke could only be withheld from the WebRTC line, because the function call lands on the browser data channel and the server is never in that loop. That is wrong. OpenAI calls the second connection a sideband control channel: either side can answer a tool call, and the side that does not simply ignores it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="1510" height="46" as="geometry"/></mxCell>
        <mxCell id="x5" value="1 · BROWSER-RUN   placement: anywhere" style="swimlane;html=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;rounded=0;swimlaneFillColor=#eef4fc;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="480" height="400" as="geometry"/></mxCell>
        <mxCell id="x6" value="WHO ANSWERS" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x5"><mxGeometry x="18" y="48" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x7" value="The browser. live/tools.js → POST /api/tool → engine →
result injected back into the data channel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x5"><mxGeometry x="18" y="68" width="440" height="40" as="geometry"/></mxCell>
        <mxCell id="x8" value="WHAT THE BROWSER SEES" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x5"><mxGeometry x="18" y="120" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x9" value="The call, the arguments and the result. It runs the tool." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x5"><mxGeometry x="18" y="140" width="440" height="30" as="geometry"/></mxCell>
        <mxCell id="x10" value="LATENCY" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x5"><mxGeometry x="18" y="182" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x11" value="Full speed. Audio never leaves the direct peer connection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x5"><mxGeometry x="18" y="202" width="440" height="30" as="geometry"/></mxCell>
        <mxCell id="x12" value="WHICH TOOLS" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x5"><mxGeometry x="18" y="244" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x13" value="list_supported_regions · rank_airports · compare_airports
get_airport_profile · get_flight_mix · end_call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x5"><mxGeometry x="18" y="264" width="440" height="40" as="geometry"/></mxCell>
        <mxCell id="x14" value="&lt;div dir=&quot;rtl&quot; style=&quot;text-align:right&quot;&gt;כולם קריאה טהורה ממאגר מקומי. אין שום מחיר בכך שהדפדפן רואה את התוצאה.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=right;spacingRight=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="x5"><mxGeometry x="18" y="316" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="x15" value="2 · SIDEBAND   placement: server" style="swimlane;html=1;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;rounded=0;swimlaneFillColor=#f0f7ee;" vertex="1" parent="1"><mxGeometry x="545" y="200" width="480" height="400" as="geometry"/></mxCell>
        <mxCell id="x16" value="WHO ANSWERS" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x15"><mxGeometry x="18" y="48" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x17" value="This server, on its own WebSocket to the SAME session.
runTool() in-process, against this process credentials." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x15"><mxGeometry x="18" y="68" width="440" height="40" as="geometry"/></mxCell>
        <mxCell id="x18" value="WHAT THE BROWSER SEES" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x15"><mxGeometry x="18" y="120" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x19" value="That the call happened, and the result the model was given.
It does not run it, and POST /api/tool refuses it 403." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x15"><mxGeometry x="18" y="140" width="440" height="40" as="geometry"/></mxCell>
        <mxCell id="x20" value="LATENCY" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x15"><mxGeometry x="18" y="192" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x21" value="Full speed — the audio path is untouched.
Attach measured at 559 ms, the tool at 302 ms." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x15"><mxGeometry x="18" y="212" width="440" height="40" as="geometry"/></mxCell>
        <mxCell id="x22" value="WHICH TOOLS" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x15"><mxGeometry x="18" y="264" width="440" height="16" as="geometry"/></mxCell>
        <mxCell id="x23" value="get_airport_weather — the one call that leaves the building" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x15"><mxGeometry x="18" y="284" width="440" height="28" as="geometry"/></mxCell>
        <mxCell id="x24" value="&lt;div dir=&quot;rtl&quot; style=&quot;text-align:right&quot;&gt;נקודת קצה שהדפדפן קורא לה לשירות חיצוני היא פרוקסי פתוח דרך כתובת השרת שלך. זה הקו.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=right;spacingRight=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="x15"><mxGeometry x="18" y="324" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="x25" value="3 · RELAYED   the session itself is here" style="undefined" vertex="1" parent="1"><mxGeometry x="1050" y="200" width="500" height="400" as="geometry"/></mxCell>
        <mxCell id="x26" value="WHO ANSWERS" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x25"><mxGeometry x="18" y="48" width="460" height="16" as="geometry"/></mxCell>
        <mxCell id="x27" value="This server, which also holds the model connection.
Nothing crosses to the browser but audio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x25"><mxGeometry x="18" y="68" width="460" height="40" as="geometry"/></mxCell>
        <mxCell id="x28" value="WHAT THE BROWSER SEES" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x25"><mxGeometry x="18" y="120" width="460" height="16" as="geometry"/></mxCell>
        <mxCell id="x29" value="Audio. Not the transcript, not the answers, not the calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x25"><mxGeometry x="18" y="140" width="460" height="30" as="geometry"/></mxCell>
        <mxCell id="x30" value="LATENCY" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x25"><mxGeometry x="18" y="182" width="460" height="16" as="geometry"/></mxCell>
        <mxCell id="x31" value="Four to five times the direct line — 1,611 ms against ~340 ms.
Echo cancellation and jitter buffering are lost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x25"><mxGeometry x="18" y="202" width="460" height="42" as="geometry"/></mxCell>
        <mxCell id="x32" value="WHEN IT IS THE ONLY ANSWER" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="x25"><mxGeometry x="18" y="256" width="460" height="16" as="geometry"/></mxCell>
        <mxCell id="x33" value="When a result must not reach the client AT ALL. The sideband
hides who runs a tool, not what it returned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="x25"><mxGeometry x="18" y="276" width="460" height="40" as="geometry"/></mxCell>
        <mxCell id="x34" value="&lt;div dir=&quot;rtl&quot; style=&quot;text-align:right&quot;&gt;זה המחיר האמיתי של סודיות מלאה, ולכן זו לא ברירת המחדל.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=right;spacingRight=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="x25"><mxGeometry x="18" y="328" width="460" height="46" as="geometry"/></mxCell>
        <mxCell id="x35" value="ENFORCED IN THREE PLACES — any one alone is theatre" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1500" height="16" as="geometry"/></mxCell>
        <mxCell id="x36" value="1.  THE SESSION
Minted with six tools, so nothing can hand the browser the
seventh before the sideband has taken responsibility for it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="652" width="480" height="70" as="geometry"/></mxCell>
        <mxCell id="x37" value="2.  THE DOOR
POST /api/tool returns 403 for placement:&quot;server&quot; — every
caller, always. That endpoint IS how a browser would reach it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="550" y="652" width="490" height="70" as="geometry"/></mxCell>
        <mxCell id="x38" value="3.  THE HANDLER
The browser skips a function call for a tool it does not own.
Both sides answering puts two outputs under one call_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1070" y="652" width="480" height="70" as="geometry"/></mxCell>
        <mxCell id="x39" value="WHAT MOVES A TOOL" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="1500" height="16" as="geometry"/></mxCell>
        <mxCell id="x40" value="One line in src/agent/tools.js:   placement: 'server'   — all three enforcement points follow from it, along with what the model is told while the sideband is still attaching.
Where a tool runs is deliberately NOT a model decision. It is set before the conversation starts and lives in the tool list rather than the instructions, because anything the model can be persuaded to do can also be injected into it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#909090;fontSize=11;align=left;spacingLeft=8;arcSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1510" height="56" as="geometry"/></mxCell>
        <mxCell id="x41" value="&lt;div dir=&quot;rtl&quot; style=&quot;text-align:right&quot;&gt;&lt;b&gt;עדיין פתוח:&lt;/b&gt; ל-POST /api/tool אין אימות. הוא מסרב למזג אוויר לכל קורא, אבל את ששת כלי הקריאה הוא מריץ לכל מי שמגיע לפורט, וה-session id שנרשם ביומן נוצר בדפדפן ולכן אינו ראיה. התיקון: טוקן קצר-חיים שנטבע יחד עם המפתח הזמני ומשמש כמזהה הסשן האמיתי.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=right;spacingRight=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="1510" height="74" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="seq-hybrid" name="11 - Sequence: the hybrid">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="gpt-realtime — one session, two connections" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1600" height="40" as="geometry"/></mxCell>
        <mxCell id="h2" value="The browser holds the audio. The server holds a second connection to the same session and answers the tools the browser must not invoke. Observed end to end — the step numbers below are the run, not a design." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#6b6b6b;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1600" height="24" as="geometry"/></mxCell>
        <mxCell id="h3" value="&lt;div dir='rtl' style='text-align:right'&gt;הדפדפן&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="108" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="h4" value="&lt;div dir='rtl' style='text-align:right'&gt;השרת שלך&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="108" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="h5" value="openai" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1100" y="108" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="h6" value="open-meteo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1480" y="108" width="200" height="42" as="geometry"/></mxCell>
        <mxCell id="h7" style="endArrow=none;dashed=1;dashPattern=4 4;strokeWidth=1;strokeColor=#9a9a9a;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="152" as="sourcePoint"/><mxPoint x="300" y="1495" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h8" style="endArrow=none;dashed=1;dashPattern=4 4;strokeWidth=1;strokeColor=#9a9a9a;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="152" as="sourcePoint"/><mxPoint x="760" y="1495" as="targetPoint"/></mxGeometry></mxCell>
