        <mxCell id="n40" value="&amp;#9201; recognise 260 &amp;#183; think 910 &amp;#183; synthesise 180&lt;br&gt;&amp;#9201; &lt;b&gt;answer 1,350 ms&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nothing streams:&lt;/b&gt; the whole reply, then the whole mp3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="772" width="440" height="84" as="geometry"/></mxCell>
