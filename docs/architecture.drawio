        <mxCell id="n4" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b&gt;&amp;#127911;&amp;nbsp; מי מתמלל אותך?&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:19px&quot;&gt;gpt-4o-transcribe&lt;/b&gt;&lt;br&gt;רץ בתוך אותו session של OpenAI &amp;#183; אין רכיב תמלול נפרד&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=middle;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="470" y="262" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;div dir='rtl' style='text-align:right'&gt;&lt;b style=&quot;font-size:16px&quot;&gt;gpt-realtime&lt;/b&gt;&lt;br&gt;מבין את מה ששאלת, מחליט אם צריך כלי, ומנסח&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="424" width="600" height="84" as="geometry"/></mxCell>
